#
# Office-document environment for adjudication and delivery on spreadsheet and
# document benchmarks: the SpreadsheetBench image (LibreOffice for recalculation)
# plus the document libraries the evidence and repair skills use.
#   docker build -f harness/env/Dockerfile.office -t veriharness-office .
ARG BASE=spreadsheetbench-v2
FROM ${BASE}
RUN apt-get update && (apt-get install -y --no-install-recommends -o Acquire::Retries=5 sqlite3 poppler-utils zip unzip xxd || apt-get install -y --no-install-recommends --fix-missing sqlite3 poppler-utils zip unzip xxd || true) && rm -rf /var/lib/apt/lists/*
# The document and data libraries the skills and the models habitually reach for.
RUN pip install --no-cache-dir python-docx python-pptx pymupdf pdfplumber pypdf PyPDF2 openpyxl xlrd \
    pandas numpy scipy statsmodels matplotlib reportlab tabulate
