# Workspace-Bench judge endpoint (copied to official/evaluation/.env by setup_benchmarks.sh
# when no .env exists). The judge container runs with host networking, so a proxy on the
# host is reachable at 127.0.0.1. The benchmark's archived runs were judged with
# claude-opus-4-8, which harness/grade/wsb.py expects as the model name.
JUDGE_BASE_URL=http://127.0.0.1:4100
JUDGE_MODEL=claude-opus-4-8
JUDGE_API_KEY=
